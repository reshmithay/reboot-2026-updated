# Copy this file to backend/.env for local development.
# Do not commit backend/.env with real secrets.

# Application
APP_ENV=development
APP_NAME=Blockchain Anomaly Detection
APP_VERSION=1.0.0
APP_PORT=8000
DEBUG=false
SECRET_KEY=changeme
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# Firebase
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# BigQuery
BIGQUERY_PROJECT_ID=
BIGQUERY_DATASET=
BIGQUERY_TABLE=transactions
BIGQUERY_ANOMALY_TABLE=anomaly_results
BIGQUERY_CLIENT_TABLE=client_registry
GOOGLE_APPLICATION_CREDENTIALS=

# Blockchain
BLOCKCHAIN_RPC_URL=https://polygon-rpc.com
BLOCKCHAIN_CHAIN_ID=137
DEPLOYER_PRIVATE_KEY=
ANOMALY_REGISTRY_ADDRESS=
AUDIT_TRAIL_ADDRESS=
RISK_SCORE_REGISTRY_ADDRESS=

# ML
ML_MODEL_PATH=ml-engine/models
ISOLATION_FOREST_MODEL=isolation_forest.pkl
AUTOENCODER_MODEL=autoencoder.pt
ANOMALY_THRESHOLD=0.7
ENABLE_PYCARET=true

# Cortex API
CORTEX_API_KEY=
CORTEX_BASE_URL=https://cortex.lloydsbanking.cloud/api
CORTEX_MODEL=gemini-2.5-flash-lite
CORTEX_TEMPERATURE=0.2
CORTEX_TIMEOUT=120

# Database
DB_TYPE=postgresql
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=anomaly_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Detection
MAX_CONCURRENT_DETECTORS=10
DETECTION_TIMEOUT_SECONDS=30
ENABLE_BIGQUERY_STORAGE=true
ENABLE_NARRATIVE_GENERATION=true

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# API
API_V1_PREFIX=/api/v1
