# Application Settings
APP_ENV=development
APP_NAME="Blockchain Anomaly Detection"
APP_VERSION=1.0.0
APP_PORT=8000
DEBUG=true
SECRET_KEY=your-secret-key-change-in-production

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Google Cloud / BigQuery
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
BIGQUERY_PROJECT_ID=your-gcp-project-id
BIGQUERY_DATASET=blockchain_anomaly_detection
BIGQUERY_TABLE=transactions

# Gemini API
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-pro

# Firebase (optional)
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# Blockchain
BLOCKCHAIN_RPC_URL=https://polygon-rpc.com
BLOCKCHAIN_CHAIN_ID=137
DEPLOYER_PRIVATE_KEY=
ANOMALY_REGISTRY_ADDRESS=
AUDIT_TRAIL_ADDRESS=
RISK_SCORE_REGISTRY_ADDRESS=

# ML Models
ML_MODEL_PATH=ml-engine/models
ISOLATION_FOREST_MODEL=isolation_forest.pkl
AUTOENCODER_MODEL=autoencoder.pt
ANOMALY_THRESHOLD=0.7
ENABLE_PYCARET=true

# LLM Narrative Server
LLM_SERVER_URL=http://localhost:8001

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=anomaly_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# Detection Settings
MAX_CONCURRENT_DETECTORS=10
DETECTION_TIMEOUT_SECONDS=30
ENABLE_BIGQUERY_STORAGE=true
ENABLE_NARRATIVE_GENERATION=true

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# API
API_V1_PREFIX=/api/v1
